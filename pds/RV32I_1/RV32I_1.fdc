# ============================================================================
# HDMI 输出 —— 4 对 TMDS 差分（1 对时钟 + 3 对数据）
# ----------------------------------------------------------------------------
# 引脚来源：盘古MINI 手册 1.4.2.5 HDMI 输出接口，与厂商 demo
#   2_10_hdmi_loop/hdmi_loop.fdc 逐条一致（同一块 MINI 板）。
# 板上 HDMI OUT 是 **FPGA 差分引脚直连 HDMI 座**，中间没有电平转换/使能芯片，
#   所以除下面这些 IO 属性外不需要任何 I2C 初始化（HDMI IN 才需要配 MS7200）。
#
# [重点] 电气规格必须照抄 demo，不能按普通 LVDS 想当然：
#   PAP_IO_STANDARD = LVDS25  +  PAP_IO_VCCIO = 2.5   —— HDMI 座是 2.5V 域
#   PAP_IO_DRIVE    = 3.5                              —— TMDS 要求的驱动强度
#   PAP_IO_NONE     = TRUE                             —— 输出不加端接（demo 原样）
#   真正的差分对由 outputserdes.v 里的 GTP_OUTBUFDS(.IOSTANDARD("TMDS")) 产生，
#   P 脚必须在真 LVDS 对的正端（N21/N22 等见手册）。
# ============================================================================

# ---- TMDS 时钟对：pixel clock（25.5MHz），HDMI_TX_CLK ----
define_attribute {p:tmds_clk_p} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:tmds_clk_p} {PAP_IO_LOC} {N21}
define_attribute {p:tmds_clk_p} {PAP_IO_VCCIO} {2.5}
define_attribute {p:tmds_clk_p} {PAP_IO_STANDARD} {LVDS25}
define_attribute {p:tmds_clk_p} {PAP_IO_DRIVE} {3.5}
define_attribute {p:tmds_clk_p} {PAP_IO_NONE} {TRUE}
define_attribute {p:tmds_clk_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:tmds_clk_n} {PAP_IO_LOC} {N22}
define_attribute {p:tmds_clk_n} {PAP_IO_VCCIO} {2.5}
define_attribute {p:tmds_clk_n} {PAP_IO_STANDARD} {LVDS25}
define_attribute {p:tmds_clk_n} {PAP_IO_DRIVE} {3.5}
define_attribute {p:tmds_clk_n} {PAP_IO_NONE} {TRUE}

# ---- TMDS 数据对 0：蓝（B[7:0]，同时承载 HS/VS）HDMI_TX_D0 ----
define_attribute {p:tmds_data_p[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:tmds_data_p[0]} {PAP_IO_LOC} {R25}
define_attribute {p:tmds_data_p[0]} {PAP_IO_VCCIO} {2.5}
define_attribute {p:tmds_data_p[0]} {PAP_IO_STANDARD} {LVDS25}
define_attribute {p:tmds_data_p[0]} {PAP_IO_DRIVE} {3.5}
define_attribute {p:tmds_data_p[0]} {PAP_IO_NONE} {TRUE}
define_attribute {p:tmds_data_n[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:tmds_data_n[0]} {PAP_IO_LOC} {P25}
define_attribute {p:tmds_data_n[0]} {PAP_IO_VCCIO} {2.5}
define_attribute {p:tmds_data_n[0]} {PAP_IO_STANDARD} {LVDS25}
define_attribute {p:tmds_data_n[0]} {PAP_IO_DRIVE} {3.5}
